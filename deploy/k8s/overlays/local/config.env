# Non-secret settings for the local cluster. URLs include :8443 because k3d maps host 8443.
KEYCLOAK_PUBLIC_URL=https://auth.localtest.me:8443
OIDC_ISSUER=https://auth.localtest.me:8443/realms/supplygraph
# The resource identifier (RFC 8707): tokens must name this exact URL in `aud`.
MCP_RESOURCE_URL=https://mcp.localtest.me:8443/mcp
# Host headers the MCP server accepts (DNS-rebinding protection). exchange-mcp:8000 is the
# in-cluster Service name, used by `make scale-test`.
MCP_ALLOWED_HOSTS=mcp.localtest.me:8443,mcp.localtest.me,exchange-mcp:8000
# Keycloak requires HTTPS for requests from outside private networks (TLS ends at Traefik).
SSL_REQUIRED=external
# Redirect URIs that self-registered (DCR) clients may use: loopback only, i.e. apps on your machine.
DCR_TRUSTED_HOSTS=["localhost","127.0.0.1"]
SG_USER=researcher
SG_USER_FIRST=Local
SG_USER_LAST=User
SG_USER_EMAIL=user@localtest.me
# SEC fair-access policy: identify yourself with a contact address. EDIT THIS before
# fetching US funds. Limit is 10 req/s per requester across ALL pods; see Stage 4.
SEC_USER_AGENT=SupplyGraph research contact@example.com
SEC_RATE_PER_S_PER_POD=2
