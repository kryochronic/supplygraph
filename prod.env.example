# Hosted SupplyGraph settings (docker-compose-prod.yml). `make prod-env` copies this to prod.env (gitignored)
# and fills in every __generate__ value. Edit prod.env, not this file. Never commit prod.env.

# --- hostnames: both need a DNS A record pointing at the VM before `make prod-up` -------
SG_HOST=app.supplygraph.prkhya.com
AUTH_HOST=auth.prkhya.com
# Let's Encrypt expiry notices; EDIT
ACME_EMAIL=you@example.com

# --- secrets: generated -----------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__generate__
KC_DB_PASSWORD=__generate__
OIDC_CLIENT_SECRET=__generate__
COOKIE_SECRET=__generate__
SG_USER_PASSWORD=__generate__

# --- your login (the bootstrap creates this user once) -----------------------------------
SG_USER=researcher
# EDIT
SG_USER_EMAIL=you@example.com
SG_USER_FIRST=Abhinav
SG_USER_LAST=Tripathi

# --- models: hosted only (no Ollama on the VM). Set at least one; leave the rest empty -----
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# The connector the app picks when none is chosen: claude | openai | openrouter
DEFAULT_CONNECTOR=claude
DISG_NODE=cloud

# --- images -------------------------------------------------------------------------------
KEYCLOAK_TAG=26.8.0
OAUTH2_PROXY_TAG=v7.12.0
POSTGRES_TAG=16-alpine
# KC_ADMIN_TUNNEL_PORT=8080
