# Exchange MCP stack settings (docker-compose-mcp.yml). `make mcp-env` copies this to mcp.env
# (gitignored) and fills in the two passwords. Edit mcp.env, not this file.

# --- secrets: generated ------------------------------------------------------------
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=__generate__
SG_USER_PASSWORD=__generate__

# --- URLs: identical to the k3d overlay ----------------------------------------------
KEYCLOAK_PUBLIC_URL=https://auth.localtest.me:8443
OIDC_ISSUER=https://auth.localtest.me:8443/realms/supplygraph
# The resource identifier (RFC 8707): tokens must carry exactly this in `aud`.
MCP_RESOURCE_URL=https://mcp.localtest.me:8443/mcp
# Host headers the MCP server accepts (DNS-rebinding protection).
MCP_ALLOWED_HOSTS=mcp.localtest.me:8443,mcp.localtest.me
MCP_HTTPS_PORT=8443

# --- realm (read by deploy/k8s/base/keycloak-bootstrap.sh) ----------------------------
SSL_REQUIRED=external
# Redirect URIs self-registered (DCR) clients may use: loopback only, i.e. apps on your machine.
DCR_TRUSTED_HOSTS=["localhost","127.0.0.1"]
SG_USER=researcher
SG_USER_FIRST=Local
SG_USER_LAST=User
SG_USER_EMAIL=user@localtest.me

# --- Keycloak features ------------------------------------------------------------------
# Must not be empty (Keycloak rejects ''). device-flow is on by default anyway and is what
# `make mcp-token` uses. Stage 3 (MCP 2026-07-28 auth, experimental in Keycloak 26.8):
# KEYCLOAK_FEATURES=device-flow,cimd,resource-indicators
KEYCLOAK_FEATURES=device-flow

# --- upstream sources ------------------------------------------------------------------
# SEC fair-access policy: name and a contact address. EDIT before fetching US funds.
SEC_USER_AGENT=SupplyGraph research contact@example.com
# 10 req/s is the SEC's limit per requester across ALL replicas: keep N × this under 10.
SEC_RATE_PER_S_PER_POD=2

# --- images ------------------------------------------------------------------------------
KEYCLOAK_TAG=26.8.0
MCP_TAG=dev
